# ── 依赖 ─────────────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── 构建产物（由 `pnpm run build` 生成；插件以 link 方式装载，靠本地 dist）────
dist/
*.tsbuildinfo

# ── npm 打包产物 ─────────────────────────────────────────────────────────────
*.tgz

# ── 凭据：绝不能提交 ─────────────────────────────────────────────────────────
# 配置里可能带 watchId / chipId（chipId 等同密码，泄露即可盗号）
.npmrc
.env
.env.*
!.env.example
# 本地联调用的凭据脚本
secrets.*.mjs

# ── 日志 ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
pnpm-debug.log*

# ── 编辑器 / 系统 ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
